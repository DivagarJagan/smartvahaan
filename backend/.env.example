# Database Configuration
DATABASE_URL=sqlite:///./smartvahan.db

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Configuration
APP_NAME=SmartVahaan AI Vehicle Maintenance

# CORS Configuration (comma-separated list of allowed origins)
# For local development:
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
# For production, add your Vercel frontend URL:
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Google Gemini API (optional - for AI features)
# GOOGLE_API_KEY=your-google-api-key-here
